{
  "name": "pomobuddy",
  "displayName": "PomoBuddy: Pomodoro Pixel Art Companion",
  "description": "Tu compañero de concentración en pixel art para VS Code y Antigravity. Temporizador Pomodoro, animaciones de baile en descansos y reacciones a tu código.",
  "version": "0.1.0",
  "publisher": "rgarduno",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rgarduno/pomobuddy"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Productivity"
  ],
  "keywords": [
    "pomobuddy",
    "pomodoro",
    "pixel art",
    "companion",
    "focus",
    "timer",
    "retro",
    "dance"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pomobuddy-sidebar",
          "title": "PomoBuddy",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pomobuddy-sidebar": [
        {
          "type": "webview",
          "id": "pomobuddy.companionView",
          "name": "PomoBuddy Companion"
        }
      ]
    },
    "commands": [
      {
        "command": "pomobuddy.start",
        "title": "Iniciar Pomodoro",
        "category": "PomoBuddy",
        "icon": "$(play)"
      },
      {
        "command": "pomobuddy.pause",
        "title": "Pausar Pomodoro",
        "category": "PomoBuddy",
        "icon": "$(debug-pause)"
      },
      {
        "command": "pomobuddy.reset",
        "title": "Reiniciar Pomodoro",
        "category": "PomoBuddy",
        "icon": "$(debug-restart)"
      },
      {
        "command": "pomobuddy.skip",
        "title": "Saltar al siguiente intervalo",
        "category": "PomoBuddy",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "pomobuddy.toggleMute",
        "title": "Silenciar / Activar Sonidos",
        "category": "PomoBuddy",
        "icon": "$(mute)"
      },
      {
        "command": "pomobuddy.openCompanion",
        "title": "Abrir Compañero Pixel",
        "category": "PomoBuddy"
      }
    ],
    "configuration": {
      "title": "PomoBuddy",
      "properties": {
        "pomobuddy.workDuration": {
          "type": "number",
          "default": 25,
          "description": "Duración de la sesión de trabajo/enfoque (en minutos)"
        },
        "pomobuddy.shortBreakDuration": {
          "type": "number",
          "default": 5,
          "description": "Duración del descanso corto (en minutos)"
        },
        "pomobuddy.longBreakDuration": {
          "type": "number",
          "default": 15,
          "description": "Duración del descanso largo (en minutos)"
        },
        "pomobuddy.roundsBeforeLongBreak": {
          "type": "number",
          "default": 4,
          "description": "Número de rondas de trabajo antes de un descanso largo"
        },
        "pomobuddy.soundEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Activar efectos de sonido retro 8-bit sintetizados"
        },
        "pomobuddy.avatar": {
          "type": "string",
          "enum": ["neko", "wizard", "robot"],
          "default": "neko",
          "description": "Avatar activo en pixel art"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}

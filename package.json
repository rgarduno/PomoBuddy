{
  "name": "pomobuddy",
  "displayName": "PomoBuddy: Pomodoro Pixel Art Companion",
  "description": "Tu compañero de concentración en pixel art para VS Code. Temporizador Pomodoro con físicas interactivas, fondos animados, descansos festivos y reacciones en tiempo real a tu código.",
  "version": "0.1.0",
  "publisher": "rgarduno",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rgarduno/PomoBuddy"
  },
  "bugs": {
    "url": "https://github.com/rgarduno/PomoBuddy/issues"
  },
  "homepage": "https://github.com/rgarduno/PomoBuddy#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Productivity"
  ],
  "keywords": [
    "pomobuddy",
    "pomodoro",
    "pixel art",
    "companion",
    "focus",
    "timer",
    "retro",
    "dance"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pomobuddy-sidebar",
          "title": "PomoBuddy",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "pomobuddy-panel",
          "title": "PomoBuddy",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pomobuddy-sidebar": [
        {
          "type": "webview",
          "id": "pomobuddy.companionView",
          "name": "Compañero"
        }
      ],
      "pomobuddy-panel": [
        {
          "type": "webview",
          "id": "pomobuddy.bottomView",
          "name": "Compañero (Panel Inferior)"
        }
      ]
    },
    "commands": [
      {
        "command": "pomobuddy.start",
        "title": "Iniciar Pomodoro",
        "category": "PomoBuddy",
        "icon": "$(play)"
      },
      {
        "command": "pomobuddy.pause",
        "title": "Pausar Pomodoro",
        "category": "PomoBuddy",
        "icon": "$(debug-pause)"
      },
      {
        "command": "pomobuddy.toggle",
        "title": "Iniciar / Pausar Pomodoro",
        "category": "PomoBuddy",
        "icon": "$(play)"
      },
      {
        "command": "pomobuddy.reset",
        "title": "Reiniciar Pomodoro",
        "category": "PomoBuddy",
        "icon": "$(debug-restart)"
      },
      {
        "command": "pomobuddy.skip",
        "title": "Saltar al siguiente intervalo",
        "category": "PomoBuddy",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "pomobuddy.toggleMute",
        "title": "Silenciar / Activar Sonidos",
        "category": "PomoBuddy",
        "icon": "$(mute)"
      },
      {
        "command": "pomobuddy.openCompanion",
        "title": "Abrir Compañero en Barra Lateral",
        "category": "PomoBuddy",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "pomobuddy.openBottomPanel",
        "title": "Abrir Compañero en Barra Inferior (Panorámico)",
        "category": "PomoBuddy",
        "icon": "$(layout-panel)"
      }
    ],
    "keybindings": [
      {
        "command": "pomobuddy.toggle",
        "key": "alt+p space",
        "mac": "cmd+alt+p space"
      },
      {
        "command": "pomobuddy.reset",
        "key": "alt+p r",
        "mac": "cmd+alt+p r"
      },
      {
        "command": "pomobuddy.skip",
        "key": "alt+p s",
        "mac": "cmd+alt+p s"
      },
      {
        "command": "pomobuddy.toggleMute",
        "key": "alt+p m",
        "mac": "cmd+alt+p m"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pomobuddy.openBottomPanel",
          "when": "view == pomobuddy.companionView",
          "group": "navigation"
        },
        {
          "command": "pomobuddy.openCompanion",
          "when": "view == pomobuddy.bottomView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "PomoBuddy",
      "properties": {
        "pomobuddy.workDuration": {
          "type": "number",
          "default": 25,
          "description": "Duración de la sesión de trabajo/enfoque (en minutos)"
        },
        "pomobuddy.shortBreakDuration": {
          "type": "number",
          "default": 5,
          "description": "Duración del descanso corto (en minutos)"
        },
        "pomobuddy.longBreakDuration": {
          "type": "number",
          "default": 15,
          "description": "Duración del descanso largo (en minutos)"
        },
        "pomobuddy.roundsBeforeLongBreak": {
          "type": "number",
          "default": 4,
          "description": "Número de rondas de trabajo antes de un descanso largo"
        },
        "pomobuddy.soundEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Activar efectos de sonido retro 8-bit sintetizados"
        },
        "pomobuddy.avatar": {
          "type": "string",
          "enum": [
            "neko",
            "wizard",
            "robot",
            "duck",
            "capy",
            "raccoon",
            "custom"
          ],
          "default": "neko",
          "description": "Avatar activo (neko, wizard, robot, duck, capy, raccoon, custom)"
        },
        "pomobuddy.background": {
          "type": "string",
          "enum": [
            "winter",
            "forest",
            "cyberpunk",
            "lofi",
            "minimal"
          ],
          "default": "winter",
          "description": "Fondo pixel art de escenario (winter, forest, cyberpunk, lofi, minimal)"
        },
        "pomobuddy.soundPack": {
          "type": "string",
          "enum": [
            "arcade",
            "zen",
            "cyber"
          ],
          "default": "arcade",
          "description": "Paquete de sonidos sintetizados: arcade (Arcade 16-bit), zen (Lo-Fi Chill), cyber (Synthwave/Cyberpunk)"
        },
        "pomobuddy.errorPersonality": {
          "type": "string",
          "enum": [
            "roast",
            "detective",
            "panic",
            "classic"
          ],
          "default": "roast",
          "description": "Personalidad del avatar ante errores de sintaxis o linter: roast (sarcástico), detective (lupa inspectora), panic (extintor de incendios), classic (reacción base)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "tsc -p ./",
    "package": "npm run build && vsce package --no-dependencies",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.3"
  }
}
